#!/bin/sh
# pre-commit guard — catches the failure mode that deleted a large amount of merged work
# in this repository (commit f76f208).
#
# That push was a normal fast-forward: the history connected fine, so git had nothing to
# complain about. What was wrong was the WORKING TREE — the files another person had added
# were simply absent from disk, so committing everything recorded them as deletions.
#
# This hook refuses a commit that deletes files which exist on origin/main. If the deletion
# is genuinely intended, run `git commit --no-verify`.
#
# Install:  cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Never interfere with merges, rebases, or cherry-picks.
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  exit 0
fi

# Shell drift guard. Runs FIRST and unconditionally, before any early exit below:
# the deletion check further down returns early on the common case ("nothing deleted"),
# which silently skipped this guard while it lived there.
#
# The BO shell (topbar / sidebar rail / content frame) is defined once, in
# assets/css/bo-shell.css. The per-module theme sheets used to re-declare the same
# layout metrics with slightly different values, which is what made the same sidebar row
# sit at a different height on different pages, and the header inset, counter row, icon
# outline, number line-height and Logout block each drift.
# check-shell-drift.js refuses a NEW metric declaration on a shell selector; the ones
# that already exist are recorded in scripts/shell-drift-baseline.json and get retired
# one theme at a time.
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-shell-drift.js; then
    printf '\n  ⛔ commit blocked — shell drift guard failed (details above).\n'
    printf '     Bypass with: git commit --no-verify\n\n'
    exit 1
  fi
fi

# SPA readiness + pin guard, also unconditional and for the same reason as above.
#
# assets/js/bo-spa.js swaps page content instead of reloading it, so a page that is missing
# one of its markers does not fail - it silently flashes, jumps or reloads in the middle of a
# session. check-spa-readiness.js tests every page for those markers AND that
# assets/js/bo-spa-manifest.js (the generated list of pages the router may intercept a link
# for) still matches the tree. pin-spa.js then checks that the pages request the revision of
# bo-spa.js and the manifest that is actually on disk: a browser that cached the previous one
# keeps running it for the whole session, which is the "I fixed that already" that cannot be
# debugged from the outside.
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-spa-readiness.js; then
    printf '\n  ⛔ commit blocked — SPA readiness check failed (details above).\n'
    printf '     Regenerate the manifest: node scripts/check-spa-readiness.js --write-manifest\n'
    printf '     Bypass with: git commit --no-verify\n\n'
    exit 1
  fi
  if ! node scripts/pin-spa.js --check; then
    printf '\n  ⛔ commit blocked — pages are pinned to an older bo-spa.js / manifest.\n'
    printf '     Fix: node scripts/pin-spa.js\n'
    printf '     Bypass with: git commit --no-verify\n\n'
    exit 1
  fi
fi

# Need origin/main to compare against; fall back silently if it is not available.
git rev-parse --verify --quiet origin/main >/dev/null 2>&1 || exit 0

deleted=$(git diff --cached --diff-filter=D --name-only)
[ -z "$deleted" ] && exit 0

hit=0
for f in $deleted; do
  if git cat-file -e "origin/main:$f" 2>/dev/null; then
    [ "$hit" = "0" ] && printf '\n'
    printf '  deleted: %s\n' "$f"
    hit=1
  fi
done

[ "$hit" = "0" ] && exit 0

cat <<'MSG'

  ⛔ commit blocked — it removes files that still exist on origin/main.

     A commit may only delete files you meant to delete. If your working copy is
     missing files you never removed, it is stale: another person's work would be
     reverted by this commit.

     What to do:
       git status                       # are those files shown as deleted?
       git fetch origin                 # get up to date
       git checkout origin/main -- .    # restore the missing files
       git diff --stat origin/main..HEAD

     If the deletion really is intended: git commit --no-verify

MSG
exit 1
